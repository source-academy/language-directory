{
  "compilerOptions": {
    "declaration": true,
    "module": "es2020",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "target": "es2020",
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/**/*"
  ]
}
